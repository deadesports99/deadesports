{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-config.json",
  "mcpServers": {
    "sonarqube": {
      "command": "npx",
      "args": [
        "-y",
        "@lomas/sonarqubemcp@latest"
      ],
      "env": {
        "SONARQUBE_URL": "${SONARQUBE_URL}",
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}"
      }
    },
    "sonarqube-official": {
      "command": "docker",
      "args": [
        "run",
        "--init",
        "-i",
        "--rm",
        "-e", "SONARQUBE_URL=${SONARQUBE_URL}",
        "-e", "SONARQUBE_TOKEN=${SONARQUBE_TOKEN}",
        "sonarsource/sonarqube-mcp"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}",
        "SUPABASE_PROJECT_REF": "${SUPABASE_PROJECT_REF}"
      }
    },
    "supabase-remote": {
      "url": "https://mcp.supabase.com/mcp"
    },
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-mcp-server"
      ]
    },
    "canva": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://api.canva.com/connect/v1/mcp",
        "8791",
        "--static-oauth-client-info",
        "{\"client_id\":\"${CANVA_CLIENT_ID}\",\"client_secret\":\"${CANVA_CLIENT_SECRET}\"}",
        "--static-oauth-client-metadata",
        "{\"token_endpoint_auth_method\":\"client_secret_basic\"}"
      ]
    }
  }
}
