rules_version = '2';

// Free Fire Tournament — Firestore security rules (Phase 2).
//
// `live_events` is written by the backend (Phase 1 mirror) and read by the backend
// (Phase 2 `GET /api/v1/live/events`). Both use the Admin SDK, which bypasses these
// rules entirely.
//
// Clients are denied on purpose:
//
//   1. A player holds our own JWT, not a Firebase custom claim, so rules cannot tell
//      which tenant they belong to. Allowing reads would expose every tenant's
//      SLOT_BOOKED / WALLET_UPDATED events to anyone with the app.
//   2. Firestore bills per document read. Client-side listeners are invisible to the
//      backend, so they cannot be metered against LIVE_FEED_MONTHLY_READ_BUDGET.
//
// If a future phase wants direct client subscriptions, replace the blanket deny with
// claim-scoped rules (request.auth.token.tenantId) AND keep the budget guard in the
// API path. Do not weaken this file without doing both.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
