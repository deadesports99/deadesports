# ==========================================
# 🔥 FIREBASE CONFIGURATION
# ==========================================
FIREBASE_PROJECT_ID=dragod-5fe23
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==========================================
# 🐘 NEON POSTGRES (ledger / source of truth)
# ==========================================
# Neon free tier: https://neon.com — card nahi, expire nahi hota.
# Connection string Neon dashboard > Connection Details se copy karo.
# ⚠️ `?sslmode=require` chhodna — Neon TLS ke bina connect nahi hota.
#
# Local Docker ke liye (docker-compose.dev.yml):
#   postgresql://postgres:postgres@localhost:5433/freefire_tournament?schema=public
#
# Neon ke liye:
#   postgresql://neondb_owner:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/freefire_tournament?schema=public

# ==========================================
# 🔍 SONARQUBE / SONARCLOUD MCP CONFIGURATION
# ==========================================
# Cloud (Free for open source): https://sonarcloud.io
# Or Local Docker: http://localhost:9000
SONARQUBE_URL=https://sonarcloud.io
SONARQUBE_TOKEN=your_sonar_user_token_here
SONAR_PROJECT_KEY=free-fire-tourney-platform
SONAR_ORGANIZATION=your_sonarcloud_organization_key

# ==========================================
# 🎨 CANVA MCP (logo / image generation + photo edit)
# ==========================================
# Canva Dev Portal > Your integration > Configuration me redirect URL daalo:
#   http://127.0.0.1:8765/callback  (pi)  +  http://localhost:8791/oauth/callback  (mcp-remote bridge)
# Secret kabhi commit na karo — .env ignored hai. Setup: docs/canva-mcp-setup.md
CANVA_CLIENT_ID=OC-your-canva-client-id
CANVA_CLIENT_SECRET=cnvca_your_canva_client_secret
