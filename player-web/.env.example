# Backend (Express + Prisma). Local dev: the API server on port 5000.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# White-label tenant every request is scoped to (seeded Apex eSports org).
VITE_TENANT_ID=a3c11cd0-324e-4886-b27c-9667fd7f59dc

# Local demo only: skip Firebase SMS and use the server's DEV_FAKE_FIREBASE
# `dev_otp_<phone>` shortcut. MUST be false for anything public.
VITE_DEV_AUTH=true

# Optional: public privacy-policy page shown in Settings → Privacy Policy.
# Leave blank (or example.com) to show only the in-app summary.
VITE_PRIVACY_POLICY_URL=
