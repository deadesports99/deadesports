# Server Configuration
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# Supabase / PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis Cache & Slot Lock URL (Local or Upstash)
REDIS_URL="redis://localhost:6379"

# Security & Tokens
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Client CORS URLs (comma separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Optional Firebase service-account JSON (one line)
# FCM_CREDENTIALS_JSON=

# ─── Online payment gateway (wallet top-up) ───────────────────────────────
# provider: "mock" (demo — no real money) or "razorpay" (real payments).
# NEVER use mock in production: the server refuses to boot production+mock.
PAYMENT_PROVIDER=mock

# Amount limits (paise: 1000 = ₹10, 1000000 = ₹10,000)
PAYMENT_MIN_AMOUNT_PAISE=1000
PAYMENT_MAX_AMOUNT_PAISE=1000000

# Checkout order lifetime + stale-order expiry sweep
PAYMENT_ORDER_TTL_SECONDS=900
PAYMENT_EXPIRY_SWEEP_INTERVAL_MS=300000

# Mock mode auto-captures the order after the demo "Pay now" click
PAYMENT_MOCK_AUTO_CAPTURE=true

# Public base URL of this API — used to build the gateway checkout URL
PUBLIC_BASE_URL=http://localhost:5000

# Razorpay credentials (required only when PAYMENT_PROVIDER=razorpay)
# Get them from: Razorpay Dashboard → Account & Settings → API Keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
