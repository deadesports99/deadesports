# Server Configuration
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# Supabase / PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Redis Cache & Slot Lock URL (Local or Upstash)
REDIS_URL="redis://localhost:6379"

# Security & Tokens
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Client CORS URLs (comma separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Optional Firebase service-account JSON (one line)
# FCM_CREDENTIALS_JSON=

# ─── Firebase live mirror (Phase 1 — plan/firebase-migration) ───
# Copies every WebSocket event into Firestore so clients can subscribe with the
# Firebase SDK. OFF by default; the /ws gateway is unaffected either way.
# Requires FCM_CREDENTIALS_JSON (a project id alone cannot write).
FIREBASE_LIVE_MIRROR=false
# FIREBASE_LIVE_MIRROR_COLLECTION=live_events
# FIREBASE_LIVE_MIRROR_TTL_HOURS=24
# FIREBASE_LIVE_MIRROR_MAX_QUEUE=500
# FIREBASE_LIVE_MIRROR_BATCH_SIZE=100

# ─── Live feed reader (Phase 2 — plan/firebase-migration) ───
# GET /api/v1/live/events — catch-up feed for clients that missed websocket events.
# OFF by default; while off the endpoint answers source="disabled" (200, empty).
LIVE_FEED_ENABLED=false
# LIVE_FEED_MAX_LIMIT=50
# LIVE_FEED_DEFAULT_LIMIT=25
# Firestore reads/month/tenant before the endpoint pauses itself (429).
# LIVE_FEED_MONTHLY_READ_BUDGET=500000

# ─── Daily aggregate snapshots → Firestore (Phase 5) ───
# One document per tenant per day: counts + money totals only (no player data).
# OFF by default. `npm run export:stats` works regardless of this flag.
STATS_EXPORT_ENABLED=false
# STATS_EXPORT_INTERVAL_HOURS=24
# STATS_EXPORT_DAYS=3
# STATS_EXPORT_COLLECTION=stats

# ─── Firebase Storage media uploads (Phase 4) ───
# POST /api/v1/media/upload — admins only, PNG/JPEG/WebP, permanent URLs.
MEDIA_UPLOAD_ENABLED=false
# FIREBASE_STORAGE_BUCKET=            # empty = <projectId>.firebasestorage.app
# MEDIA_MAX_UPLOAD_BYTES=5242880

# Firebase Phone (SMS) OTP kill switch.
#   true  (default) = phone OTP signup/login allowed for players
#   false          = phone OTP off; players use Email OTP / Google sign-in
# ADMIN / SUB_ADMIN logins are never blocked by this switch.
PHONE_OTP_ENABLED=true

# ⚠️ DEMO ONLY (any phone + any OTP bypass). NEVER leave this true in production.
PHONE_OTP_BYPASS=false
# DEMO/LOCAL ONLY: these IPs skip rate limiting. Empty in production.
RATE_LIMIT_ALLOW_IPS=127.0.0.1,::1

# ─── Admin web credentials ────────────────────────────────────────────────
# HMAC pepper for staff permission keys and hashed email OTPs.
# MUST be 32+ random chars. Production boot refuses the development default.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_KEY_PEPPER=dev-only-insecure-pepper-change-me-0123456789

# ─── Online payment gateway (wallet top-up) ───────────────────────────────
# provider: "mock" (demo — no real money) or "razorpay" (real payments).
# NEVER use mock in production: the server refuses to boot production+mock.
PAYMENT_PROVIDER=mock

# Amount limits (paise: 1000 = ₹10, 1000000 = ₹10,000)
PAYMENT_MIN_AMOUNT_PAISE=1000
PAYMENT_MAX_AMOUNT_PAISE=1000000

# Checkout order lifetime + stale-order expiry sweep
PAYMENT_ORDER_TTL_SECONDS=900
PAYMENT_EXPIRY_SWEEP_INTERVAL_MS=300000

# Mock mode auto-captures the order after the demo "Pay now" click
PAYMENT_MOCK_AUTO_CAPTURE=true

# Public base URL of this API — used to build the gateway checkout URL
PUBLIC_BASE_URL=http://localhost:5000

# Razorpay credentials (required only when PAYMENT_PROVIDER=razorpay)
# Get them from: Razorpay Dashboard → Account & Settings → API Keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Join burst control (see tournament.service.ts): at most N joins hit the DB at
# once, up to M more wait in memory, the rest get a 503 "try again".
# Keep N <= your Postgres pool size (Supabase session pooler caps at 15).
JOIN_MAX_INFLIGHT=12
JOIN_MAX_QUEUE=400

# ─── Admin web session / email ────────────────────────────────────────────
# Admin web session lifetime — shorter than the 7d player JWT.
ADMIN_SESSION_TTL_HOURS=12
# Exact admin-web origin (CSRF Origin/Referer gate). Prod: https://your-admin-host
ADMIN_WEB_ORIGIN=http://localhost:5174
# Email provider for owner OTPs: console (dev) | smtp | resend | brevo
EMAIL_PROVIDER=console
# From header shown to the owner.
EMAIL_FROM="Apex Free Fire Club <no-reply@apexff.com>"
