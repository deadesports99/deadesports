# ─── Online payment gateway (wallet top-up) ─────────────────────────────────
# Copy these into backend/.env and fill the values you need.
# Everything here has a safe default EXCEPT the Razorpay keys (needed only when
# PAYMENT_PROVIDER=razorpay).

# mock     -> no keys, no network. Perfect for local demos and tests.
# razorpay -> real UPI / cards / netbanking (India).
PAYMENT_PROVIDER=mock

# Razorpay dashboard -> Settings -> API Keys
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay dashboard -> Settings -> Webhooks -> signing secret
# Endpoint: https://<your-domain>/api/payments/webhook
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Top-up bounds in PAISE (100 = ₹1). Defaults: ₹10 min, ₹10,000 max.
PAYMENT_MIN_AMOUNT_PAISE=1000
PAYMENT_MAX_AMOUNT_PAISE=1000000

# Checkout window (seconds). Orders past this flip to EXPIRED automatically.
PAYMENT_ORDER_TTL_SECONDS=900

# Mock mode only: true = "Pay now" credits instantly, false = leaves PENDING
# so you can test the /verify handshake.
PAYMENT_MOCK_AUTO_CAPTURE=true

# How often stale CREATED/PENDING orders are expired (milliseconds).
PAYMENT_EXPIRY_SWEEP_INTERVAL_MS=300000

# Public HTTPS base URL of THIS backend. Used for the mock checkout link.
# Production example: https://api.deadesports.com
PUBLIC_BASE_URL=http://localhost:5000
