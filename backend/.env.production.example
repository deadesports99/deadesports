# Copy to backend/.env.production for the VPS Compose deployment.
# Never commit the copied file or paste real secrets into this example.

NODE_ENV=production
PORT=5000
TRUST_PROXY=true

# Neon Postgres (ledger). Neon ka `-pooler` host optional hai — traffic kam hai,
# isliye direct host use karo. `?sslmode=require` chhodna mat.
DATABASE_URL="postgresql://neondb_owner:<password>@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# VPS Compose uses the internal Redis service. For Upstash use rediss://...
REDIS_URL="redis://redis:6379"

JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# Optional Firebase push credentials, encoded as one-line JSON.
# FCM_CREDENTIALS_JSON=

# Caddy variables (used by docker-compose.prod.yml).
API_DOMAIN="api.example.com"
ACME_EMAIL="admin@example.com"

# MUST be absent/false in production — the server refuses to boot with it on.
DEV_FAKE_FIREBASE=false
