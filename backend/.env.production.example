# Copy to backend/.env.production for the VPS Compose deployment.
# Never commit the copied file or paste real secrets into this example.

NODE_ENV=production
PORT=5000
TRUST_PROXY=true

# Supabase Pooler: use port 6543 and keep the pool bounded.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# VPS Compose uses the internal Redis service. For Upstash use rediss://...
REDIS_URL="redis://redis:6379"

JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# Optional Firebase push credentials, encoded as one-line JSON.
# FCM_CREDENTIALS_JSON=

# Caddy variables (used by docker-compose.prod.yml).
API_DOMAIN="api.example.com"
ACME_EMAIL="admin@example.com"
