{
  "$schema": "https://modelcontextprotocol.io/schema/mcp-config.json",
  "mcpServers": {
    "sonarqube": {
      "command": "npx",
      "args": [
        "-y",
        "@lomas/sonarqubemcp@latest"
      ],
      "env": {
        "SONARQUBE_URL": "${SONARQUBE_URL}",
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}"
      }
    },
    "sonarqube-official": {
      "command": "docker",
      "args": [
        "run",
        "--init",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_URL=${SONARQUBE_URL}",
        "-e",
        "SONARQUBE_TOKEN=${SONARQUBE_TOKEN}",
        "sonarsource/sonarqube-mcp"
      ]
    },
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-mcp-server"
      ]
    },
    "hermes": {
      "command": "C:\\Users\\Jay Kumar\\AppData\\Local\\hermes\\bin\\hermes.exe",
      "args": [
        "mcp-serve"
      ]
    }
  }
}
